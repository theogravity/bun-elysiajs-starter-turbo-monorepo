{
  "name": "monorepo-boilerplate",
  "description": "",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "turbo watch dev",
    "build": "turbo run build",
    "db:migrate:create": "cd apps/backend && bun run db:migrate:create",
    "db:migrate:latest": "cd apps/backend && bun run db:migrate:latest",
    "db:migrate:undo": "cd apps/backend && bun run db:migrate:undo",
    "clean:repo": "git add --all && git reset --hard",
    "clean": "bun run clean:node_modules && bun run clean:turbo && bun run clean:dist && bun run clean:hash-runner",
    "clean:workspaces": "turbo clean",
    "clean:node_modules": "find . -name \"node_modules\" -type d -prune -exec rm -rf '{}' +",
    "clean:turbo": "find . -name node_modules -prune -o -name .turbo -type d -prune -exec rm -rf '{}' +",
    "clean:dist": "find . -name node_modules -prune -o -name dist -type d -prune -exec rm -rf '{}' +",
    "clean:hash-runner": "find . -name node_modules -prune -o -name .hashes.json -type f -delete",
    "syncpack:update": "syncpack update && syncpack fix && bun install",
    "syncpack:format": "syncpack format",
    "syncpack:lint": "syncpack lint",
    "verify-types": "turbo run verify-types --continue --",
    "lint": "turbo run lint --continue --",
    "lint:packages": "syncpack lint",
    "test": "turbo run test --continue --"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@internal/tsconfig": "workspace:*",
    "@types/node": "26.3.0",
    "lefthook": "2.1.10",
    "syncpack": "15.3.3",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "engineStrict": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
