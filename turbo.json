{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "clean": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build"
      ]
    },
    "build:dev": {
      "cache": false
    },
    "dev": {
      "cache": false
    },
    "lint": {},
    "lint:staged": {
      "cache": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "verify-types": {
      "dependsOn": [
        "^build"
      ]
    },
    "prod": {
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "install-browsers": {
      "cache": false
    }
  }
}
