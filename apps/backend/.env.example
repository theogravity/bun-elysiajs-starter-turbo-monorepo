DB_HOST=localhost
DB_PORT=5432
DB_NAME=backend
DB_USER=admin
DB_PASS=testing123
SERVER_PORT=3080

# Log level for the backend (fatal|error|warn|info|debug|trace)
BACKEND_LOG_LEVEL=debug

# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcd
# Public origin of this API
BETTER_AUTH_URL=http://localhost:3080
# Origin allowed to call the API with credentials
FRONTEND_URL=http://localhost:5173

# Bootstrap admin created by `bun run db:seed:run`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme12345

# SMTP. Defaults point at the smtp4dev container from docker compose.
# Read what the app sent at http://localhost:5001
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_FROM=no-reply@example.com
# SMTP_USER=
# SMTP_PASS=
