{
  "name": "@internal/backend",
  "description": "",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "db:migrate:create": "kysely migrate make",
    "db:migrate:latest": "kysely migrate latest",
    "db:migrate:undo": "kysely migrate down",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "compile": "bun build --compile --target=bun --bytecode --minify --sourcemap ./src/index.ts --outfile ./dist/backend",
    "clean": "rm -rf .turbo node_modules dist",
    "dev": "bun run --watch ./src/index.ts",
    "lint": "biome check --no-errors-on-unmatched --write --unsafe src",
    "lint:staged": "biome check --no-errors-on-unmatched --write --unsafe --staged src",
    "prod": "bun run ./dist/index.js",
    "test": "vitest --run",
    "verify-types": "tsc --noEmit"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "2.21.0",
    "@elysiajs/cors": "1.4.2",
    "@elysiajs/openapi": "1.4.15",
    "@internal/backend-errors": "workspace:*",
    "@loglayer/elysia": "2.4.0",
    "@loglayer/transport-simple-pretty-terminal": "3.3.0",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "elysia": "1.4.30",
    "env-var": "7.5.0",
    "kysely": "0.29.5",
    "loglayer": "9.4.0",
    "nanoid": "6.0.1",
    "pg": "8.23.0",
    "serialize-error": "13.0.1",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@elysiajs/eden": "1.4.9",
    "@faker-js/faker": "10.6.0",
    "@internal/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "26.3.0",
    "@types/pg": "8.23.1",
    "jiti": "2.7.0",
    "kysely-ctl": "0.21.0",
    "tsc-alias": "1.9.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
